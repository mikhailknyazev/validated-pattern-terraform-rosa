# Local .terraform directories
**/.terraform/*

# .terraform lock files
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# *.tfvars
# *.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore state files
*.tfstate
*.tfstate.*

# Ignore backup files
*.backup

# Ignore plan files
*.tfplan

# Ignore environment files
.env
.env.local

# RHCS credentials (user-managed, never commit)
.rhcs_creds
.rhcs_client_creds

# AWS Client VPN configs (contain certs and keys)
*.ovpn

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Editor history files
.history/

# Reference implementations (embedded git repos at repo root only)
/reference/

# Duplicate/obsolete terraform modules directory (only contains cache)
terraform/modules/

# OS files
.DS_Store
Thumbs.db

# Scratch directory for temporary files
scratch/

# Python bytecode / cache (any location)
__pycache__/
*.py[cod]
*$py.class

# Per-cluster apply/bootstrap/destroy logs (local operator artifacts)
clusters/*/logs/

# Local agent / Superpowers session scratch (brainstorm TUI, logs, pids). Keep docs/superpowers/ tracked.
.superpowers/

# Generated bootstrap values (Terraform output, same dir as tfvars)
clusters/*/cluster-bootstrap-values.yaml

# ACM spoke import manifests written by bootstrap-gitops.sh into CWD (may contain hub kubeconfig)
acm-crds.yaml
*-import.yaml

kubeconfig
values.generated.yaml

# MkDocs local build
.venv-docs/
site/
