{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeviceCodeCache",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "<secret-arn>"
    },
    {
      "Sid": "DeviceCodeCacheKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "<kms-key-arn>"
    }
  ]
}
